<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Circular Floating Button Container -->
    <FrameLayout
        android:id="@+id/floating_button_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_floating_button"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true">

        <!-- Barcode Scanner Vector Icon -->
        <ImageView
            android:id="@+id/iv_floating_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_barcode_floating" />

    </FrameLayout>

</FrameLayout>
